{
  "name": "asteria-card-garden",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.ts server/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev:local": "npm run build && node --env-file-if-exists=.env server/local.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
