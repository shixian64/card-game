# Copy to .env. Never commit .env or place secrets in VITE_* variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/asteria.sqlite
ALLOW_DEV_LOGIN=0
# Bare server: trust only the actual reverse proxy IP/CIDR; empty ignores forwarded headers.
# Never use 0.0.0.0/0 or ::/0. Dev-login still checks the socket, not this header.
TRUSTED_PROXIES=

# Obtain a registered website identity OAuth client from OpenAI.
# Registered callback: https://YOUR_DOMAIN/auth/openai/callback
OPENAI_CLIENT_ID=
# none for public clients; client_secret_basic for confidential clients.
OPENAI_TOKEN_AUTH_METHOD=none
OPENAI_CLIENT_SECRET=
# Comma-separated OpenAI sub identifiers. No auto-admin on first sign-in.
ADMIN_OPENAI_SUBJECTS=

# LINUX DO Connect login (primary production entry). See docs/LINUXDO_AUTH_DESIGN.md.
# Registered callback: https://card.shixinn.com/auth/linuxdo/callback (derive from APP_ORIGIN).
# Set CLIENT_ID and SECRET together or leave both empty to disable the entry.
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post, both declared by the provider.
LINUXDO_TOKEN_AUTH_METHOD=client_secret_basic
# Comma-separated verified LINUX DO sub identifiers. No auto-admin on first sign-in.
ADMIN_LINUXDO_SUBJECTS=

# Required only for Docker Compose + Caddy deployment.
DOMAIN=
# Compose uses this fixed Caddy peer as TRUSTED_PROXIES. Change both if the subnet conflicts.
CADDY_PROXY_IP=172.30.0.2
PROXY_SUBNET=172.30.0.0/24

# ── 双人短局主对局（DUEL-RULES-1）───────────────────────────────────────────
# 旧单人局（旧 PvE）新建开关：正式切换后设 0 停止新开旧局；存量局按冻结规则结束。
LEGACY_MATCH_STARTS=1
# 双人房间服务端调度器扫描间隔（毫秒，默认 1000）。
DUEL_SCHEDULER_TICK_MS=1000
